# --- Runtime ---
NODE_ENV=Development
PORT=3000
DEBUG_MODE=false

# --- Database (PostgreSQL) ---
DB_HOST="localhost"
DB_PORT=5432
DB_USER="user"
DB_PASSWORD="your_password"
