meta {
  name: OpenAPI document
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/docs.json
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("exposes every route group", function () {
    expect(res.body.openapi).to.match(/^3\./);
    expect(Object.keys(res.body.paths)).to.include.members(["/api/auth/login", "/api/spaces", "/api/bookings", "/api/memberships"]);
  });
}
