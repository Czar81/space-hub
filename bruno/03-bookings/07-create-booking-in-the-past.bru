meta {
  name: Create booking in the past
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/bookings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{memberToken}}
}

body:json {
  {
    "spaceId": {{spaceId}},
    "startTime": "2020-03-11T10:00:00Z",
    "endTime": "2020-03-11T12:00:00Z"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("returns a JSON error body", function () {
    expect(res.getHeader("content-type")).to.contain("application/json");
    expect(res.body.status).to.equal("error");
    expect(res.body.message).to.be.a("string");
  });
}
