meta {
  name: Update space as member forbidden
  type: http
  seq: 13
}

put {
  url: {{baseUrl}}/api/spaces/{{spaceId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{memberToken}}
}

body:json {
  {
    "capacity": 1
  }
}

assert {
  res.status: eq 403
}

tests {
  test("returns a JSON error body", function () {
    expect(res.getHeader("content-type")).to.contain("application/json");
    expect(res.body.status).to.equal("error");
    expect(res.body.message).to.be.a("string");
  });
}
