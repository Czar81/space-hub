meta {
  name: Deactivate space success
  type: http
  seq: 17
}

delete {
  url: {{baseUrl}}/api/spaces/{{tempSpaceId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("space is kept but inactive", function () {
    expect(res.body.id).to.equal(bru.getVar("tempSpaceId"));
    expect(res.body.isActive).to.equal(false);
  });
}
