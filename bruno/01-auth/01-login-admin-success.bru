meta {
  name: Login admin success
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("adminToken", res.body.token);
  bru.setVar("adminRefresh", res.body.refreshToken);
}

tests {
  test("returns admin user and token", function () {
    expect(res.body.token).to.be.a("string");
    expect(res.body.refreshToken).to.be.a("string");
    expect(res.body.user.role).to.equal("ADMIN");
    expect(res.body.user).to.not.have.property("password");
  });
}
