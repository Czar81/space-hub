meta {
  name: Register member success
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno Member",
    "email": "{{memberEmail}}",
    "password": "password123"
  }
}

assert {
  res.status: eq 201
}

script:pre-request {
  bru.setVar("memberEmail", `member.${Date.now()}@example.com`);
}

script:post-response {
  bru.setVar("memberToken", res.body.token);
  bru.setVar("memberId", res.body.user.id);
}

tests {
  test("creates a MEMBER without leaking the password", function () {
    expect(res.body.user.role).to.equal("MEMBER");
    expect(res.body.user).to.not.have.property("password");
    expect(res.body.token).to.be.a("string");
  });
}
