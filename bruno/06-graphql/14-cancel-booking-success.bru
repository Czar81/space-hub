meta {
  name: Cancel booking success
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/graphql
  body: json
  auth: bearer
}

auth:bearer {
  token: {{memberToken}}
}

body:json {
  {
    "query": "mutation { cancelBooking(id: \"{{gqlBookingId}}\") { status } }"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("is canceled", function () {
    expect(res.body.data.cancelBooking.status).to.equal("CANCELED");
  });
}
