meta {
  name: Memberships as member forbidden
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/graphql
  body: json
  auth: bearer
}

auth:bearer {
  token: {{memberToken}}
}

body:json {
  {
    "query": "{ memberships { userId } }"
  }
}

assert {
  res.status: in 200,500
}

tests {
  test("is forbidden", function () {
    expect(res.body.errors[0].extensions.code).to.equal("FORBIDDEN");
  });
}
