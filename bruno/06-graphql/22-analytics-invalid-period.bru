meta {
  name: Analytics invalid period
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/graphql
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "query": "{ occupancyAnalytics(from: \"2090-04-01\", to: \"2090-03-01\") { totalSpaces } }"
  }
}

assert {
  res.status: in 200,500
}

tests {
  test("is a bad request", function () {
    expect(res.body.errors[0].extensions.code).to.equal("BAD_REQUEST");
  });
}
