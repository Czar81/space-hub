meta {
  name: Spaces public
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/graphql
  body: json
  auth: none
}

body:json {
  {
    "query": "{ spaces { id name location } }"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("lists spaces without token", function () {
    expect(res.body.data.spaces).to.be.an("array");
  });
}
