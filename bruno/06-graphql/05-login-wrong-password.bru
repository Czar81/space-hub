meta {
  name: Login wrong password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/graphql
  body: json
  auth: none
}

body:json {
  {
    "query": "mutation { login(email: \"admin@spacehub.com\", password: \"bad\") { token } }"
  }
}

assert {
  res.status: in 200,500
}

tests {
  test("is unauthorized", function () {
    expect(res.body.errors[0].extensions.code).to.equal("UNAUTHORIZED");
  });
}
