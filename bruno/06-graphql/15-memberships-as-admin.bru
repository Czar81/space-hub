meta {
  name: Memberships as admin
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/graphql
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "query": "{ memberships { userId plan user { email } } }"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("lists memberships", function () {
    expect(res.body.data.memberships.length).to.be.greaterThan(0);
  });
}
