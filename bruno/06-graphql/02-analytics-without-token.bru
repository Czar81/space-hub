meta {
  name: Analytics without token
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/graphql
  body: json
  auth: none
}

body:json {
  {
    "query": "{ occupancyAnalytics { totalSpaces } }"
  }
}

assert {
  res.status: in 200,500
}

tests {
  test("is rejected", function () {
    expect(res.body.errors[0].extensions.code).to.equal("UNAUTHORIZED");
  });
}
