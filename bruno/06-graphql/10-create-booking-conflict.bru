meta {
  name: Create booking conflict
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/graphql
  body: json
  auth: bearer
}

auth:bearer {
  token: {{otherToken}}
}

body:json {
  {
    "query": "mutation { createBooking(spaceId: {{spaceId}}, startTime: \"2091-04-01T10:30:00Z\", endTime: \"2091-04-01T11:30:00Z\") { id } }"
  }
}

assert {
  res.status: in 200,500
}

tests {
  test("conflicts", function () {
    expect(res.body.errors[0].extensions.code).to.equal("CONFLICT");
  });
}
