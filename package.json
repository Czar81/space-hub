{
  "name": "spacehub-api",
  "version": "2.1.0",
  "description": "SpaceHub API - Coworking management",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec \"ts-node -r tsconfig-paths/register\" src/server.ts",
    "build": "tsc && tsc-alias && cp src/graphql/schema.graphql dist/graphql/schema.graphql",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:api": "cd bruno && bru run --env local",
    "lint": "eslint src prisma",
    "format": "prettier --write src prisma",
    "format:check": "prettier --check src prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^4.18.2",
    "express-graphql": "^0.12.0",
    "express-rate-limit": "^8.7.0",
    "graphql": "^15.3.0",
    "graphql-subscriptions": "^2.0.0",
    "graphql-ws": "^5.16.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.19.43",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.5.13",
    "@usebruno/cli": "^4.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.10",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.9",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  }
}
